{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:presskg-dataset-ita:schema:gold-graph:1.0.0",
  "title": "PressKG_Dataset_ITA — gold graph",
  "description": "Viste documentale e core derivate da annotazioni verificate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "world_id",
    "ontology_version",
    "predicate_registry_version",
    "projection_version",
    "scope",
    "article_ids",
    "nodes",
    "documentary_claims",
    "core_edges"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "world_id": { "$ref": "#/$defs/id" },
    "ontology_version": { "$ref": "#/$defs/profile_version" },
    "predicate_registry_version": { "$ref": "#/$defs/profile_version" },
    "projection_version": { "$ref": "#/$defs/profile_version" },
    "scope": { "$ref": "#/$defs/scope" },
    "article_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "documentary_claims": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/claim_ref" }
    },
    "core_edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/core_edge" }
    }
  },
  "if": {
    "properties": {
      "scope": {
        "properties": {
          "kind": { "const": "article" }
        }
      }
    }
  },
  "then": {
    "properties": {
      "article_ids": { "minItems": 1, "maxItems": 1 }
    }
  },
  "$defs": {
    "id": {
      "$ref": "urn:presskg-dataset-ita:schema:common:1.0.0#/$defs/id"
    },
    "profile_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "temporal_value": {
      "$ref": "urn:presskg-dataset-ita:schema:common:1.0.0#/$defs/temporal_value"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["article", "scenario", "corpus"] },
        "id": { "$ref": "#/$defs/id" }
      }
    },
    "claim_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["article_id", "claim_id"],
      "properties": {
        "article_id": { "$ref": "#/$defs/id" },
        "claim_id": { "$ref": "#/$defs/id" }
      }
    },
    "mention_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["article_id", "mention_id"],
      "properties": {
        "article_id": { "$ref": "#/$defs/id" },
        "mention_id": { "$ref": "#/$defs/id" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "support"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "Identificativo canonico del nodo nel mondo sintetico."
        },
        "type": { "$ref": "#/$defs/id" },
        "observed_labels": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "\\S" },
          "description": "Nomi o alias effettivamente osservati nei documenti dell'ambito."
        },
        "event_type": { "$ref": "#/$defs/id" },
        "occurrence_time": { "$ref": "#/$defs/temporal_value" },
        "support": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/mention_ref" },
              { "$ref": "#/$defs/claim_ref" }
            ]
          }
        }
      },
      "if": {
        "properties": {
          "type": { "const": "Event" }
        }
      },
      "else": {
        "properties": {
          "event_type": false,
          "occurrence_time": false
        }
      }
    },
    "core_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject_id", "predicate", "object_id", "support"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "subject_id": { "$ref": "#/$defs/id" },
        "predicate": {
          "$ref": "#/$defs/id",
          "description": "Predicato nella forma canonica del registro."
        },
        "object_id": { "$ref": "#/$defs/id" },
        "valid_time": { "$ref": "#/$defs/temporal_value" },
        "qualifiers": { "type": "object" },
        "support": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/claim_ref" }
        }
      }
    }
  }
}